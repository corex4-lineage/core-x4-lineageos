# Core-X4 : noyau 4.9 sans FS_IOC_ADD_ENCRYPTION_KEY -> cree le trousseau fscrypt (init A12+ ne le fait plus)
on late-init
    exec u:r:init:s0 root root -- /system/bin/x4keyring

# Core-X4 : reglages par defaut (voyant batterie = flash photo sur ce materiel)
on property:sys.boot_completed=1
    exec_background u:r:shell:s0 shell shell -- /system/bin/sh /system/bin/x4defaults.sh
